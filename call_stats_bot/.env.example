# Токен «вашей CRM» из настроек интеграции МегаФон ВАТС.
CALLBOT_MEGAFON_CRM_TOKEN=replace-with-a-long-random-value

# Telegram-бот и получатели отчёта (несколько ID — через запятую).
CALLBOT_TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CALLBOT_TELEGRAM_CHAT_IDS=123456789
# Пользователи Telegram, которым разрешены команды управления Bitrix24.
CALLBOT_TELEGRAM_ADMIN_IDS=123456789
CALLBOT_TELEGRAM_WEBHOOK_SECRET=replace-with-another-random-value
CALLBOT_TELEGRAM_POLLING_ENABLED=false
# Публичный HTTPS URL Mini App. Можно использовать тот же домен, что и webhook.
CALLBOT_MINIAPP_PUBLIC_URL=https://tg.example.ru/support/

# Ключ — внутренний номер ext сотрудника в ВАТС, значение — имя в отчёте.
CALLBOT_EMPLOYEES={"713":"Сотрудник 713","708":"Сотрудник 708"}

# Необязательно: при наличии CRM API имена обновляются из /users перед отчётом.
CALLBOT_MEGAFON_API_URL=https://vats000000.megapbx.ru/crmapi/v1
CALLBOT_MEGAFON_API_KEY=replace-with-api-key
CALLBOT_MEGAFON_API_AUTH_HEADER=X-API-KEY

CALLBOT_REPORT_TIME=19:00
CALLBOT_TIMEZONE=Europe/Moscow
CALLBOT_DATABASE_PATH=data/call_stats.sqlite3

# Ежедневная расшифровка, разделение спикеров и краткая выжимка.
CALLBOT_OPENAI_API_KEY=replace-with-openai-api-key
CALLBOT_ANALYSIS_ENABLED=true
CALLBOT_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
CALLBOT_CALL_SUMMARY_MODEL=gpt-5-mini
CALLBOT_ANALYSIS_CONCURRENCY=2
CALLBOT_ANALYSIS_DOWNLOAD_TIMEOUT_SECONDS=120
CALLBOT_ANALYSIS_MAX_AUDIO_BYTES=104857600
# Необязательный закрытый relay, если production-сервер не имеет маршрута к ВАТС.
CALLBOT_RECORDING_RELAY_URL=https://panel.example.ru/internal/supportflow/recording

# Предпочтительно использовать уже существующий внутренний Bitrix Gateway.
CALLBOT_BITRIX_GATEWAY_URL=http://bitrix-gateway:8000
CALLBOT_BITRIX_GATEWAY_TOKEN=replace-with-internal-token
CALLBOT_BITRIX_GATEWAY_PROFILE=default
# Внутренний номер MegaFon → ID пользователя Bitrix24. Ключи должны в точности
# совпадать с CALLBOT_EMPLOYEES.
CALLBOT_BITRIX_USER_MAP={"713":916,"708":294}

# Либо прямой входящий вебхук Bitrix24. Никогда не добавляйте его в git.
# CALLBOT_BITRIX_WEBHOOK_URL=https://example.bitrix24.ru/rest/USER/SECRET
CALLBOT_SUBSTITUTION_POLL_SECONDS=60
# Состав сотрудников и наличие активных сделок обновляются каждые 5 минут.
CALLBOT_EMPLOYEE_POLL_SECONDS=300
